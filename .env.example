# ---- llama.cpp 运行时 ----
# vulkan | cuda | cpu | external
# external = 复用你已手动启动的 llama-server（需同时设置 LLAMA_SERVER_URL）
RUNTIME_BACKEND=vulkan
# LLAMA_SERVER_URL=http://127.0.0.1:8081
LLAMA_PORT=8081
N_GPU_LAYERS=99
# 单次请求的上下文总预算。输入（系统提示+全部历史+检索片段+图片 token）与输出
# 共用这一份，不是各自独立；输出额度 = 该值 - 输入已占用。
# 未出现在 N_CTX_OVERRIDES 里的模型用这个值。
N_CTX=16384
# 按模型单独设上下文：「文件名(不含 .gguf)=tokens」，逗号分隔，切换模型时自动生效。
# 取值上限是 GGUF 里记录的原生训练上下文，超了输出质量会掉；实际能开多大由显存决定。
# 括号内是 24GB 卡 / -ngl 99 / 单 slot 下的实测峰值显存（已含约 1.1GB 桌面基线）：
#   gemma-4-E4B-it-Q4_K_M   原生 131072，取满（6.8GB；KV 仅约 17KB/token）
#   Qwen3-8B-Q4_K_M         原生  40960，取满（11.2GB；KV 约 145KB/token）
#   Qwen3.8-27B-UD-Q3_K_XL  原生 262144，但 KV 约 65KB/token，只能开一部分：
#                           65536→18.5GB   98304→20.5GB  114688→21.6GB
#                           131072→22.6GB   196608 起直接 OOM
#                           以上是加载时的占用。实际推理还要再吃约 1.3GB 计算缓冲，
#                           且它与提示长度无关（76k 和 93k token 实测都是这个数），
#                           所以 98304 的最坏峰值约 21.8GB、剩 2.6GB，这就是采用值。
#                           131072 加载后只剩 1.8GB，扣掉这 1.3GB 就没有余量了。
#                           图片理解本身只额外占 128MB，不是瓶颈。
# 27B 开到 98304 后最坏要占 21.8GB，与 ComfyUI（约 10.8GB）同跑必然 OOM，两者只能二选一。
N_CTX_OVERRIDES=gemma-4-E4B-it-Q4_K_M=131072,Qwen3-8B-Q4_K_M=40960,Qwen3.8-27B-UD-Q3_K_XL=98304
# 追加给 llama-server 的原始参数，例如：SERVER_EXTRA_ARGS=-fa 1 --temp 0.7
# 不要在这里加 -np / --parallel：应用已固定单 slot，多 slot 会把 -c 平摊，
# 实测 -np 4 -c 16384 会让每次请求只剩 4096。
SERVER_EXTRA_ARGS=
# 等 llama-server 就绪的上限秒数。27B 冷启动要加载约 13GB 权重并编译 Vulkan 着色器，
# 300 秒是实测够用的余量；调小会让大模型启动被误判为失败。
SERVER_STARTUP_TIMEOUT=300

# ---- 模型 ----
# 这里只是「首次启动」的默认值。运行后可在网页顶栏的下拉框里随时切换，
# 选择会记住在 runtime/active_model.json —— 删掉该文件即回到下面的默认值。
# 下拉框扫描 MODEL_PATH 所在目录下的全部 *.gguf（mmproj-* 除外，不递归子目录），
# 并按文件名自动为每个模型配对 mmproj；配不上对就没有图片理解能力。
# MMPROJ_PATH 留空表示纯文本模型。
MODEL_PATH=F:/models/gguf/gemma-4-E4B-it-Q4_K_M.gguf
MMPROJ_PATH=F:/models/gguf/mmproj-gemma-4-E4B-it-Q8_0.gguf

# ---- 生成参数 ----
# 本节的 TEMPERATURE / TOP_P / MAX_TOKENS / MAX_TOOL_ROUNDS / THINKING_MAX_TOKENS，
# 加上下面联网检索的 SEARCH_PROVIDER / SEARCH_MAX_RESULTS，再加上 SYSTEM_PROMPT，
# 共 8 项可以在网页左下角「设置」里直接改：保存后立即对下一条消息生效，
# 不必编辑本文件也不必重启。改动记在 runtime/settings_override.json，见文件末尾说明。
# ENABLE_THINKING 不在这 8 项里，只能改本文件并重启。
#
# SYSTEM_PROMPT 在这里没有示例行：默认值是一段很长的中文提示词，写在
# app/config.py 的 DEFAULT_SYSTEM_PROMPT 里。要改请用网页左下角的「设置」面板——
# 那里是多行文本框，而且立即生效。
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=2048
MAX_TOOL_ROUNDS=4
# 默认是否勾选顶栏的「深度思考」。勾选框的状态存在浏览器里，会覆盖这个默认值；
# 这里只决定新访客第一次打开页面时是勾上还是没勾。
ENABLE_THINKING=false
# 思考过程与回答共用 MAX_TOKENS 之外的这一份独立预算。推理型模型（Gemma 4、Qwen3）
# 会先写一大段 reasoning_content，给太少会在还没开始作答时就被截断。
THINKING_MAX_TOKENS=4096

# ---- 联网检索 ----
# auto | bing | bocha | tavily
# auto 的优先级：bocha > tavily > bing
# bing 走必应公开 RSS，免密钥，仅限个人非商业用途。
# 注意：cn.bing.com 只提供中国区索引（mkt/cc/ensearch 参数无法切换），
# 中文与大众话题相关性良好，英文长尾技术词较弱；
# 应用已要求模型只发 1~3 个关键词的短查询来规避这一点。
# 若需要更高质量的英文检索，配一个 BOCHA_API_KEY 或 TAVILY_API_KEY 即可，
# SEARCH_PROVIDER=auto 会自动优先使用它们。
SEARCH_PROVIDER=auto
SEARCH_MAX_RESULTS=5
# BOCHA_API_KEY=
# TAVILY_API_KEY=

# ---- Web 应用 ----
HOST=127.0.0.1
PORT=8123
# 对话历史存在 runtime/history/ —— 每个会话一个 JSON，外加 index.json 供左侧列表和搜索使用。
# 无需配置（含图片的会话可能有几 MB）；删掉整个目录即清空全部历史对话。

# ---- 文件上传与解析（无可配置项，这里只说明代价）----
# 输入栏左侧的文档按钮支持 .md .txt .pdf .docx .xlsx .pptx，单条消息最多 3 个、
# 单个不超过 25MB。解析全部在服务端内存里完成，原始文件不落盘，也没有上传目录要清理。
# 所有上限都是 app/documents.py 里的模块常量（与 MAX_IMAGE_BYTES 等同一惯例），
# 因此本文件没有新增任何键，设置面板的可编辑项也没有变化。
# 需要知道的三件事：
#   1. PDF 走 pymupdf4llm 1.28.2 的神经布局分析，依赖约 93MB 的轮子、装完约 205MB
#      （pymupdf 105 + onnxruntime 45 + numpy 36 + networkx 19），其中 49MB 是随轮子
#      打包的 ONNX 模型，解析时不联网。
#   2. 这些库是惰性导入的：不用 PDF 就一分钱不付。首次解析要加载布局模型，
#      实测导入 1.03 秒、常驻内存增加约 194MB，之后每页约 0.3 秒（冷启动 0.5 秒）。
#      PDF 单次最多解析 50 页，最坏情况约 20 秒。
#   3. 2007 以前的 .doc / .xls / .ppt 不支持，需先在 Office 或 WPS 里另存为新格式；
#      扫描版 PDF 没有文字层，本应用不做 OCR，会明确提示改用图片上传。
# PyMuPDF 是 C 库，遇到病态 PDF 有极小概率段错误直接带走进程，try/except 拦不住
# （所有 C 系 PDF 库的共性）。真崩了用 start_app.bat 重启即可。

# ---- 导出文件（无可配置项，这里只说明代价）----
# 顶栏的导出按钮导出整段对话，每条消息右上角紧挨复制的那个导出单条，左下角
# 「导出」分区选格式。导出的是屏幕上已经渲染好的内容，不调用模型：不花 token，
# 也不占用 llama-server 那个唯一的 slot（-np 1），所以回答还在流式生成时也能导出。
# 五种格式分两侧跑：MD / HTML / CSV 全在浏览器里就地完成，一次网络往返都不花；
# PDF 与 DOCX 由 POST /api/export 在服务端内存里生成，同样不落盘。
# 上限都是 app/export.py 里的模块常量（MAX_EXPORT_BLOCKS 1200、
# MAX_EXPORT_HTML_CHARS 400000、MAX_EXPORT_PAGES 60，与 MAX_DOC_BYTES 同一惯例），
# 因此本文件没有新增任何键，设置面板的可编辑项也没有变化。
# 需要知道的四件事：
#   1. 没有新依赖。PDF 复用上传解析已经装好的 pymupdf，DOCX 是手写的 OOXML
#      （五个 zip 部件，用 documents._parse_docx 当预言机往返验证过），
#      MD / HTML / CSV 用浏览器已经渲染好的结果，Python 侧不需要 markdown 库。
#   2. PDF 是一页一页装箱装出来的，判据是 insert_htmlbox 返回值的第二个元素
#      scale >= 1.0。只看第一个（剩余高度）会漏掉静默缩小：实测 200 段一次性塞进
#      一页返回 (0.0, 0.1591) —— 字确实都在，只是缩到 1.7pt，看上去是一页空白。
#      实测代价：单独 import pymupdf 0.064 秒 / 常驻 45MB（不是 pymupdf4llm 的
#      1.03 秒，那个只在解析上传的 PDF 时才付）；一次装箱探测 17.15 毫秒；
#      300 块 → 16 页 / 44 次探测 / 0.58 秒。收尾必须 tobytes(garbage=4,
#      deflate=True)：同一份 6 页文档实测裸 tobytes() 是 18,502,649 字节，
#      加了这两个参数是 27,206 字节（680 倍），因为 insert_htmlbox 每页都嵌一份
#      CJK 字体而裸 tobytes() 把每一份都留下，单独调 subset_fonts() 收敛不了。
#   3. 两条 CSS 是承重的，动之前先读 app/export.py 里的实测记录：
#      *{overflow-wrap:break-word} —— MuPDF 既不在 <pre> 里折行、也不断开散文中
#        断不了的长词，那一行于是横向溢出，insert_htmlbox 把整页缩小来补偿。
#        实测一条 300 字符的代码行让 scale 掉到 0.2873，加上它回到 1.0000。
#        word-break:break-all、overflow-wrap:anywhere 和旧别名 word-wrap:break-word
#        三种拼法在 MuPDF 的 CSS 子集里全部无效，别顺手"整理"成它们。
#      table{width:100%} —— 少了它 MuPDF 按内容给表格定宽，一张 30 行的普通短表格
#        实测掉到 0.8634、37 行的掉到 0.6840；加上它都回到 1.0000。
#      残留限制：MuPDF 按列里最长的不可断词给列定宽，所以一个塞了 180 个连续
#      ASCII 字符的单元格会把整份文档钉在 0.9086，与行数无关（60 行 → 52 页，
#      其中 48 页 0.91、4 页 0.51）。仍然可读，只是没有铺满页宽。
#   4. 图片永远不会被导出。renderMarkdown 没有图片分支，![alt](src) 只渲染成
#      一个字的 "!" 加一个链接，msg.images 里的 base64 从来不进 markdown 输出。
#      链接则两侧都保留：PDF 与 DOCX 都是真超链接，不是只剩样式化的文字。
#      （PDF 里的链接注释要 tobytes() 之后重开文档才看得见，在活动页上调
#      get_links() 返回空列表 —— 别据此以为链接丢了。）
# 导出用浅色配色（白底黑字、代码块 #f6f7f9），与屏幕上的深色主题不同：文件是
# 拿去别处看、打印、进 Word 的。最危险的一个值是 style.css 里 .md pre 的深色底
# #10131a，在白纸上会印成一整块实心黑，两份导出 CSS 里都必须换成 #f6f7f9。
# ⚠️ 系统提示词里新加的那句「用户想要文件时，直接输出完整的 Markdown 正文，并
# 提示他点导出」对保存过提示词的用户不生效 —— 见下面的优先级：
# settings_override.json 与本文件里的 SYSTEM_PROMPT 都会盖掉默认值。
# 导出按钮本身照常可用，少的只是模型主动提一句。导出面板检测到生效的提示词里
# 没有这句话时会给出提示，但不会去改你亲手编辑过的覆盖文件。

# ---- MCP 与原生能力（filesystem MCP + 记忆 + 分步思考）----
# 顶栏因此多了四个勾选框：分步、记忆、文件、写入。四个都默认不勾，而且每一个都能
# 单独关 —— 全开时工具 schema 要 5309 token，见下面的单价表。
#
# 先说依赖：Python 侧零新增，requirements.txt 一个字没改。MCP 客户端是纯标准库
# 写的（asyncio 子进程 + 换行分隔的 JSON-RPC），实测握手、tools/list、tools/call
# 用这些就够了，不需要 mcp 这个包。需要的是 Node.js（实测 v22.23.2 / npm 10.9.8）
# 和一个 npm 包：
#     .venv\Scripts\python.exe scripts\fetch_mcp.py
# 它把 @modelcontextprotocol/server-filesystem 装进 runtime\mcp\（已被 .gitignore
# 覆盖）。实测 103 个包 / 22 秒 / 31MB / 4026 个文件，直接依赖只有 sdk + diff +
# glob + minimatch，纯 JS，没有浏览器二进制。脚本幂等：已装好只打印一行，
# --force 会删掉 runtime\mcp 重装。没装或没有 Node.js，应用照常启动，只是「文件」
# 「写入」灰掉并在悬停时说明原因；start_app.bat 里的 launcher.ps1 会提示一次。
# 判断 registry 通不通只能用 npm（npm view 实测 12.3 秒拿到 metadata），curl 不行，
# 走 schannel 会 TLS 握手失败（curl: (35)）。
#
# 启动是惰性的：不勾「文件」就一分钱不付。第一次要把 Node 模块从磁盘读进系统缓存，
# 实测 6.1 秒；之后每次 0.2 秒左右（连测三次 0.19 / 0.20 / 0.22）。相比之下一次
# 本地推理是几秒级，所以这 0.2 秒看不见。
MCP_ENABLED=true
# 允许模型访问的目录，逗号分隔，留空 = 本项目目录。这一项不在设置面板的可编辑白名单
# 里：改根目录等于用新的 argv 重启一个 Node 子进程，而那个白名单的契约是「下一条消息
# 就生效、不必重启」，把需要重启的项放进去是撒谎。下面四项同理，全部只读展示。
# MCP_FS_ROOTS=
# Node.js 可执行文件路径，留空 = 自动发现。四级：本项 > PATH 里的 node > 注册表
# HKLM/HKCU 的 Path 逐项找 node.exe > 已知安装位置兜底。第三级是承重的：装完 Node
# 之后已经开着的终端读到的是安装前的 PATH 快照，which node 找不到，而注册表已经是
# 新的 —— 本机正是这种情况。
# MCP_NODE_PATH=
# 等 MCP 子进程握手的上限秒数。冷启动实测 6.1 秒，30 是给病态磁盘留的余量。
MCP_STARTUP_TIMEOUT=30
# 关掉就不再有 remember / recall 两个工具，顶栏「记忆」灰掉。
MEMORY_ENABLED=true
#
# 🔴 安全：默认根目录就是本项目目录，而本项目目录里有 .env。MCP 服务器只认「路径在
# 不在允许的根目录内」，它没有「敏感文件」这个概念 —— 实测 read_text_file 拿到 .env
# 会成功返回内容，里面是 BOCHA / Tavily 的密钥，然后进 runtime/history/ 的会话归档。
# 拦它的是本应用自己的分派层（app/tools.py 的 is_denied），不是协议：
#   文件名  .env（放行 .env.example）、*.key *.pem *.p12 *.pfx、id_rsa*
#           id_ed25519*、credentials*、secrets*
#   目录    runtime/ .venv/ venv/ .git/ node_modules/ __pycache__/ .mypy_cache/
#           .pytest_cache/
# 目录那份除了隐私也是为了性能：不挡住 runtime/ 与 .venv/，一次 directory_tree 就会
# 去走 runtime/llama-vulkan 那几百 MB。换一个 MCP 服务器就要把这份名单重新评估一遍。
#
# 🔴 拦它的只有一层。「子进程的工作目录也算一层」这个直觉是错的，出处在下面。
# 名单一开始只认「长得像绝对路径」的参数，理由是「相对路径服务器自己会拒」—— 这句话
# 也是错的。装好的那份服务器里读出来的（dist/lib.js 的
# resolveRelativePathAgainstAllowedDirectories）：相对参数是逐个按**允许的根目录**
# 解析的，解析完才问在不在根目录内；只有在服务器一条根目录都没有时才会去看
# process.cwd()，而 dist/index.js 在启动阶段就禁止那种情况。默认根目录是本项目，
# 于是 ".env"、"./.env"、"app/../.env" 全都落在真 .env 上。实测四种写法三种成功
# 返回了密钥内容，只有绝对路径那一种被名单拦住。
#   承重的一层  一切非绝对路径直接拒绝（app/tools.py 的 is_denied），回一句「请改用
#           绝对路径」。不去猜相对路径落在哪里 —— 猜就是要假设一个工作目录，而服务器
#           用的那个 base 恰恰是允许的根目录，也就是我们最不想要的那个地方。系统提示
#           词里那句「路径必须写成绝对路径」因此是承重的，不只是建议。
#   配套的    收集参数的 _paths_in 是**失败即拒绝**的：任何字符串都当位置参数送进
#           is_denied，除非它的键名在两个显式豁免集合里 —— 内容类（content / text /
#           oldText / newText / pattern / query）与选项类（excludePatterns / sortBy /
#           dryRun / edits / head / tail）。两个集合是逐个从暴露的工具 schema 里数出
#           来的，tests/test_mcp.py::test_every_live_parameter_is_classified 会对着真
#           的 tools/list 校验：上游哪天加了个谁都没归类的参数，测试就红。豁免集合吞
#           掉一个真位置参数也有对应的测试挡着。
#   不是安全层的  app/mcp.py 的 _child_cwd 仍然把 Node 子进程的工作目录设在系统临时
#           目录（不用 runtime/mcp：它在默认根目录「里面」，".." 能爬回 runtime/）。
#           按上面读到的解析逻辑，这对路径判定**没有任何影响**，留着只是卫生：在别的
#           项目目录里 spawn 一个子进程本来就是不好的默认值。它的 docstring 明写了这
#           一点，免得下次又被当成一层防护。
# 诚实的边界：directory_tree 的输出里仍然会「列出」.env 这个文件名（它从允许的父目录
# 出发）；名单拦的是以这些路径为目标的调用，不是输出里的字符串。密钥内容只有直接
# read_text_file 才会出现，而那一条被拦掉了。反过来，.env.example 是放行的 ——
# 拒绝 .env 的那句话就是让模型去读它，里面只有注释掉的占位符。
#
# 🔴「写入」的含义：勾上之后模型能在允许的目录里新建、改写、移动文件。move_file 实质
# 是删除加改名，没有回收站，也不会先征求你的确认。默认根目录是本项目，也就是说勾上
# 之后模型能改写这个应用自己的源码。缓解措施都做了（默认不勾、必须先勾「文件」、
# 每一次写调用都 log.warning 记下工具名与目标路径），但缓解不等于消除。要真正安全就
# 把 MCP_FS_ROOTS 指向一个沙箱目录，代价是模型看不到项目里的东西。
#
# 工具集单价（用本仓自己的 estimate_tokens + budget_safety 实测，n_messages=8；
# budget_safety 那列已经是「系统提示词 + 追加行 + 工具 schema + 模板常数」的合计，
# 也就是真正上线的那份开销）：
#   组合                 个数   schema tok   budget_safety   占 16384   占 40960
#   只有检索                2          807            1737      10.6%       4.2%
#   +生成文档               3         1312            2389      14.6%       5.8%
#   +分步                   3         1080            2099      12.8%       5.1%
#   +记忆                   4         1492            2550      15.6%       6.2%
#   +分步+记忆              5         1764            2911      17.8%       7.1%
#   +分步+记忆+生成文档      6         2269            3562      21.7%       8.7%
#   +文件只读              11         3948            5278      32.2%      12.9%
#   +文件读写（全开）       15         5309            6756      41.2%      16.5%
# 分层单价：文件只读层 6 个 = 2184 token，写入层 4 个再加 1361。单个工具：
# remember 405、recall 284、think 274、save_document 504。系统提示词是按功能追加的
# （记忆 128、分步 89、生成文档 146、写入 117；文件只读那条会把允许的目录原样写成
# 绝对路径，所以它的价随根目录的个数与长度浮动，本机一条根目录时是 184），
# 关着的功能一分钱不付。
# 追加的内容每次请求现算，所以不受下面
# settings_override.json 盖掉 SYSTEM_PROMPT 的影响 —— 你自己写的提示词一个字没动，
# 这一点与导出那节的 ⚠️ 不同（那句是直接写进默认提示词的）。
# ⚠️ 16384 是悬崖：在用的三个模型都 ≥40960（见 N_CTX_OVERRIDES），但任何新加的、
# 没进 overrides 的 GGUF 会落到 N_CTX=16384，那时全开的开销就吃掉 41%。
# 所以五个勾选框没有一个默认打开，要加就一个一个来。
#
# 服务器一共报告 14 个工具，只暴露 10 个。丢掉的 4 个及理由（app/tools.py 的
# FS_DROP）：read_file 是上游自己标了 DEPRECATED 的 read_text_file 别名；
# read_media_file 返回 base64，直接进提示词就是 token 炸弹，而本应用已经有图片上传
# 通道；list_directory_with_sizes 与 list_directory + get_file_info 重叠；
# list_allowed_directories 问的东西已经在提示词里直接告诉模型了，不必花 226 token。
# 分级不硬编码工具名，而是按 tools/list 返回的 annotations.readOnlyHint —— 上游改版
# 加了新工具时行为可预期：新的只读工具自动进只读层，新的写工具自动被「写入」挡住。
# 没有 annotations 的工具按「会写」处理（fail-closed）。
#
# 工具结果有上限，而且是必需的：结果不经过 fit_budget（那个裁剪的是请求进来时的历史，
# 工具结果是在循环内部追加的），没有上限就完全没有界限。实测 directory_tree 打本项目
# 根目录 = 1,302,893 字符 / 2.8MB / 33,762 行 / 0.18 秒（因为会走 .venv 和
# runtime/llama-vulkan）。上限是两个模块常量而不是 Settings 字段（与 MAX_DOC_BYTES
# 同一惯例）：单条 8000 字符（约 4950 token，40960 的 12.1%），一次请求所有轮次累计
# 24000 字符；用完之后后续工具调用直接回一句「预算已用完」，不再真去调。
# 另一条实测教训：MCP 的响应乱序到达（连发 4 个请求实测回来 3,2,4,5），而且一条响应
# 可以大到撑爆 asyncio 默认的 64KiB 行上限 —— 所以客户端是一个常驻 reader 按 id
# 路由，并显式把 limit 设成 32MiB。两者都在 app/mcp.py 里。
#
# 记忆存在 runtime/memory.json，单文件（不像 history/ 那样两层：一条记忆是一句话，
# 500 条也才几十 KB）。上限 500 条、每条 500 字，recall 一次最多回 5 条，都在
# app/memory_store.py 里。删掉这个文件即清空全部；也可以在网页左下角的「记忆」面板里
# 逐条删或一键清空 —— 一个模型能写、用户看不见的持久存储是不可审计的，所以那个面板是
# 必需的卫生而不是装饰。recall 是关键词打分（中文按双字切），不是语义检索：
# 「导出格式」能找到含「导出」或「格式」的记忆，找不到换个说法表达同一件事的那条。
#
#「分步」与「深度思考」的区别，两者不冲突，同开时一起显示在「思考过程」里：
#   深度思考  用模型自带的 reasoning_content，只有部分模型支持，每次调用独立。
#   分步      工具式的草稿纸（think），任何能调工具的模型都能用，中间步骤能跨工具轮次
#             保留。代价是每步吃掉一个 MAX_TOOL_ROUNDS 的轮次 —— 这是刻意的，免费
#             思考就是死循环风险 —— 所以有 16 步的上限兜底。

# ---- 让模型生成文件（无可配置项，这里只说明代价）----
# 顶栏又多了一个勾选框「生成文档」（连同联网检索、深度思考与上面那四个，一共七个）。
# 勾上之后模型可以调用 save_document 主动递一份文件给你，不用你再去点导出。默认不勾，
# 而且和其余依赖工具调用的勾选框一样受 supports_tools 门禁：模型不支持工具调用时自动
# 取消勾选并灰掉（「深度思考」刻意不在此列，它不依赖工具调用）。
# 单价见上面的表（schema 504 + 提示词行 146），上限是 app/tools.py 里的
# MAX_ARTIFACT_CHARS / MAX_ARTIFACT_NAME 两个模块常量，因此本文件同样没有新增任何键。
#
# 🔴 MAX_TOKENS=2048 是这个功能的硬约束，也是最容易踩的一条。整篇文档要作为一个 JSON
# 字符串参数传回来，所以它和回答共用同一份生成长度预算。实测（用本仓自己的
# estimate_tokens，样本是一份带标题、列表、表格和代码块的中文报告）：
#   2472 字符 = 2365 token，即 1.045 字符/token；作为 JSON 参数再贵 13.6%。
# 直接除下来只有约 1900 字符，但 estimate_tokens 是标定过偏高的（见 app/documents.py
# 里那五个 1.36~1.90 的比值），按最紧的 1.36 折回来约 2900。提示词里告诉模型的是
# 2400 —— 报 1900 会让它每份文档都白白空掉四分之一窗口，报 2900 则会经常撞上限。
# 想要更长的文档就调大 MAX_TOKENS，代价是每一轮回复的上限一起变大。
# 勾选「深度思考」时走的是 MAX_THINKING_TOKENS=4096，文档能长一倍 —— 这就是同一句话
# 有时能生成长文档、有时不能的原因。
#
# 写超了不会得到一个残缺的文件，也不是一片空白。这一版顺带修了两个既有 bug，它们不是
# 本功能引入的，但本功能会让它们天天出现（app/llm.py）：
#   1. 参数 JSON 被截断时 _parse_args 以前返回 {}，于是「半篇文档」和「模型没给参数」
#      长得一样，工具拿到空参数，什么也没发生。现在两者分得开：检索继续用 {} 走
#      _fallback_query 降级（一字未改），其余工具明确回一句「参数被截断，本次调用没有
#      执行」，不去分派 —— 一个半篇的文档不该被执行。
#   2. 生成撞上限时 llama-server 回的是 finish_reason="length"，不是 "tool_calls"，
#      于是那个攒了一半的调用被整个 break 掉；如果这一轮只调工具没写正文（本功能的
#      常态），流里一个 delta 都没有，用户看到完全空白的回复。现在会明确报错并说明是
#      长度上限，同时建议把要求拆小。**不重试**，理由是算术而不是取舍：MAX_TOKENS 在
#      同一次请求的每一轮都一样，装不下的参数原样再试一次还是装不下，重试只会把
#      MAX_TOOL_ROUNDS 的 4 轮烧光，最后落在一句泛泛的「已达到最大工具轮次」。
#
# 五种格式的 content **一律是完整的 Markdown 源文本**，format 只决定下载成哪种容器。
# 这不是省事，是既有管道本来的形状：MD 直接落盘、HTML 套模板、CSV 解析 Markdown 表格、
# PDF 与 DOCX 走 blocksFromMarkdown -> POST /api/export，四条全都吃 Markdown 源文本。
# 所以 CSV 同样需要文档里有 Markdown 表格，找不到表格时会提示而不是产生一个空文件。
# 也所以服务端**从来不**渲染 Markdown：app/export.py 对 md/html/csv 的拒绝是刻意的
# （那份 docstring 写着「Refusing them is what stops a server-side markdown dependency
# from growing later」），本功能一个字没改它。
#
# 文件由**浏览器**下载，落在浏览器的下载目录，不会写进本项目 —— 那是「写入」勾选框
# （MCP write_file）做的事，两个能力刻意不重叠。渲染也在浏览器：模型把 Markdown 交给
# 服务端，服务端经 SSE 原样转给浏览器，浏览器走的就是导出按钮那一条 exportMarkdown。
# 一份实现，不会漂移。卡片上永远带一个「下载」按钮，因为自动下载靠程序化 a.click()，
# 没有用户手势在背后，浏览器有权拒绝 —— 按钮是真实的用户手势，无论自动下载成不成都能用。
#
# 归档影响：文档正文会存进 runtime/history/*.json（app/main.py 的 StoredArtifact，
# 每条消息最多 8 份、单份最多 MAX_ARTIFACT_CHARS 字符，上界 320KB，现实约 3KB）。
# 存的是 Markdown 源文本而不是文件，所以刷新或重开会话之后卡片还在，并且可以重新下载
# 成当时没选的格式。history.py 一个字没改：它逐字存取 messages，新字段自动通过，
# 归档通路上唯一的闸门就是那个 Pydantic 模型 —— 与 reasoning / sources / had_images
# 当初加进来时同一个位置。
# ⚠️ 一个只有文档、没有正文的助手轮不会进下一轮的请求（前端的 isSendable 要求正文非空），
# 但归档里照旧留着记录。这与「上一轮回复为空」那条既有策略是同一个：只在发送边界过滤，
# 坏会话自愈，不需要迁移。提示词已经要求模型附一句话说明，正常情况下正文非空。

# ---- runtime/settings_override.json（无需配置，这里只说明它是什么）----
# 网页左下角「设置」面板保存的改动写在这个文件里，优先级高于本文件：
#   settings_override.json  >  .env  >  app/config.py 里的默认值
# 它只能包含上面提到的那 8 项（SYSTEM_PROMPT、TEMPERATURE、TOP_P、MAX_TOKENS、
# MAX_TOOL_ROUNDS、THINKING_MAX_TOKENS、SEARCH_PROVIDER、SEARCH_MAX_RESULTS）；
# 其余键即使在文件里出现也会被忽略，不会生效。
# 面板里的「恢复 .env 默认值」就是删掉这个文件，手动删除效果相同。
# 通过面板保存是立即生效的；直接手改这个文件则要重启应用才会读到。
# 手改出错（JSON 语法坏了、数值越界）时应用会忽略整个文件并照常启动，不会起不来。
