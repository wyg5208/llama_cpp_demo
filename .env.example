# ---- llama.cpp 运行时 ----
# vulkan | cuda | cpu | external
# external = 复用你已手动启动的 llama-server（需同时设置 LLAMA_SERVER_URL）
RUNTIME_BACKEND=vulkan
# LLAMA_SERVER_URL=http://127.0.0.1:8081
LLAMA_PORT=8081
N_GPU_LAYERS=99
# 单次请求的上下文总预算。输入（系统提示+全部历史+检索片段+图片 token）与输出
# 共用这一份，不是各自独立；输出额度 = 该值 - 输入已占用。
# 未出现在 N_CTX_OVERRIDES 里的模型用这个值。
N_CTX=16384
# 按模型单独设上下文：「文件名(不含 .gguf)=tokens」，逗号分隔，切换模型时自动生效。
# 取值上限是 GGUF 里记录的原生训练上下文，超了输出质量会掉；实际能开多大由显存决定。
# 括号内是 24GB 卡 / -ngl 99 / 单 slot 下的实测峰值显存（已含约 1.1GB 桌面基线）：
#   gemma-4-E4B-it-Q4_K_M   原生 131072，取满（6.8GB；KV 仅约 17KB/token）
#   Qwen3-8B-Q4_K_M         原生  40960，取满（11.2GB；KV 约 145KB/token）
#   Qwen3.8-27B-UD-Q3_K_XL  原生 262144，但 KV 约 65KB/token，只能开一部分：
#                           65536→18.5GB   98304→20.5GB  114688→21.6GB
#                           131072→22.6GB   196608 起直接 OOM
#                           以上是加载时的占用。实际推理还要再吃约 1.3GB 计算缓冲，
#                           且它与提示长度无关（76k 和 93k token 实测都是这个数），
#                           所以 98304 的最坏峰值约 21.8GB、剩 2.6GB，这就是采用值。
#                           131072 加载后只剩 1.8GB，扣掉这 1.3GB 就没有余量了。
#                           图片理解本身只额外占 128MB，不是瓶颈。
# 27B 开到 98304 后最坏要占 21.8GB，与 ComfyUI（约 10.8GB）同跑必然 OOM，两者只能二选一。
N_CTX_OVERRIDES=gemma-4-E4B-it-Q4_K_M=131072,Qwen3-8B-Q4_K_M=40960,Qwen3.8-27B-UD-Q3_K_XL=98304
# 追加给 llama-server 的原始参数，例如：SERVER_EXTRA_ARGS=-fa 1 --temp 0.7
# 不要在这里加 -np / --parallel：应用已固定单 slot，多 slot 会把 -c 平摊，
# 实测 -np 4 -c 16384 会让每次请求只剩 4096。
SERVER_EXTRA_ARGS=
# 等 llama-server 就绪的上限秒数。27B 冷启动要加载约 13GB 权重并编译 Vulkan 着色器，
# 300 秒是实测够用的余量；调小会让大模型启动被误判为失败。
SERVER_STARTUP_TIMEOUT=300

# ---- 模型 ----
# 这里只是「首次启动」的默认值。运行后可在网页顶栏的下拉框里随时切换，
# 选择会记住在 runtime/active_model.json —— 删掉该文件即回到下面的默认值。
# 下拉框扫描 MODEL_PATH 所在目录下的全部 *.gguf（mmproj-* 除外，不递归子目录），
# 并按文件名自动为每个模型配对 mmproj；配不上对就没有图片理解能力。
# MMPROJ_PATH 留空表示纯文本模型。
MODEL_PATH=F:/models/gguf/gemma-4-E4B-it-Q4_K_M.gguf
MMPROJ_PATH=F:/models/gguf/mmproj-gemma-4-E4B-it-Q8_0.gguf

# ---- 生成参数 ----
# 本节的 TEMPERATURE / TOP_P / MAX_TOKENS / MAX_TOOL_ROUNDS / THINKING_MAX_TOKENS，
# 加上下面联网检索的 SEARCH_PROVIDER / SEARCH_MAX_RESULTS，再加上 SYSTEM_PROMPT，
# 共 8 项可以在网页左下角「设置」里直接改：保存后立即对下一条消息生效，
# 不必编辑本文件也不必重启。改动记在 runtime/settings_override.json，见文件末尾说明。
# ENABLE_THINKING 不在这 8 项里，只能改本文件并重启。
#
# SYSTEM_PROMPT 在这里没有示例行：默认值是一段很长的中文提示词，写在
# app/config.py 的 DEFAULT_SYSTEM_PROMPT 里。要改请用网页左下角的「设置」面板——
# 那里是多行文本框，而且立即生效。
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=2048
MAX_TOOL_ROUNDS=4
# 默认是否勾选顶栏的「深度思考」。勾选框的状态存在浏览器里，会覆盖这个默认值；
# 这里只决定新访客第一次打开页面时是勾上还是没勾。
ENABLE_THINKING=false
# 思考过程与回答共用 MAX_TOKENS 之外的这一份独立预算。推理型模型（Gemma 4、Qwen3）
# 会先写一大段 reasoning_content，给太少会在还没开始作答时就被截断。
THINKING_MAX_TOKENS=4096

# ---- 联网检索 ----
# auto | bing | bocha | tavily
# auto 的优先级：bocha > tavily > bing
# bing 走必应公开 RSS，免密钥，仅限个人非商业用途。
# 注意：cn.bing.com 只提供中国区索引（mkt/cc/ensearch 参数无法切换），
# 中文与大众话题相关性良好，英文长尾技术词较弱；
# 应用已要求模型只发 1~3 个关键词的短查询来规避这一点。
# 若需要更高质量的英文检索，配一个 BOCHA_API_KEY 或 TAVILY_API_KEY 即可，
# SEARCH_PROVIDER=auto 会自动优先使用它们。
SEARCH_PROVIDER=auto
SEARCH_MAX_RESULTS=5
# BOCHA_API_KEY=
# TAVILY_API_KEY=

# ---- Web 应用 ----
HOST=127.0.0.1
PORT=8123
# 对话历史存在 runtime/history/ —— 每个会话一个 JSON，外加 index.json 供左侧列表和搜索使用。
# 无需配置（含图片的会话可能有几 MB）；删掉整个目录即清空全部历史对话。

# ---- 文件上传与解析（无可配置项，这里只说明代价）----
# 输入栏左侧的文档按钮支持 .md .txt .pdf .docx .xlsx .pptx，单条消息最多 3 个、
# 单个不超过 25MB。解析全部在服务端内存里完成，原始文件不落盘，也没有上传目录要清理。
# 所有上限都是 app/documents.py 里的模块常量（与 MAX_IMAGE_BYTES 等同一惯例），
# 因此本文件没有新增任何键，设置面板的可编辑项也没有变化。
# 需要知道的三件事：
#   1. PDF 走 pymupdf4llm 1.28.2 的神经布局分析，依赖约 93MB 的轮子、装完约 205MB
#      （pymupdf 105 + onnxruntime 45 + numpy 36 + networkx 19），其中 49MB 是随轮子
#      打包的 ONNX 模型，解析时不联网。
#   2. 这些库是惰性导入的：不用 PDF 就一分钱不付。首次解析要加载布局模型，
#      实测导入 1.03 秒、常驻内存增加约 194MB，之后每页约 0.3 秒（冷启动 0.5 秒）。
#      PDF 单次最多解析 50 页，最坏情况约 20 秒。
#   3. 2007 以前的 .doc / .xls / .ppt 不支持，需先在 Office 或 WPS 里另存为新格式；
#      扫描版 PDF 没有文字层，本应用不做 OCR，会明确提示改用图片上传。
# PyMuPDF 是 C 库，遇到病态 PDF 有极小概率段错误直接带走进程，try/except 拦不住
# （所有 C 系 PDF 库的共性）。真崩了用 start_app.bat 重启即可。

# ---- 导出文件（无可配置项，这里只说明代价）----
# 顶栏的导出按钮导出整段对话，每条消息右上角紧挨复制的那个导出单条，左下角
# 「导出」分区选格式。导出的是屏幕上已经渲染好的内容，不调用模型：不花 token，
# 也不占用 llama-server 那个唯一的 slot（-np 1），所以回答还在流式生成时也能导出。
# 五种格式分两侧跑：MD / HTML / CSV 全在浏览器里就地完成，一次网络往返都不花；
# PDF 与 DOCX 由 POST /api/export 在服务端内存里生成，同样不落盘。
# 上限都是 app/export.py 里的模块常量（MAX_EXPORT_BLOCKS 1200、
# MAX_EXPORT_HTML_CHARS 400000、MAX_EXPORT_PAGES 60，与 MAX_DOC_BYTES 同一惯例），
# 因此本文件没有新增任何键，设置面板的可编辑项也没有变化。
# 需要知道的四件事：
#   1. 没有新依赖。PDF 复用上传解析已经装好的 pymupdf，DOCX 是手写的 OOXML
#      （五个 zip 部件，用 documents._parse_docx 当预言机往返验证过），
#      MD / HTML / CSV 用浏览器已经渲染好的结果，Python 侧不需要 markdown 库。
#   2. PDF 是一页一页装箱装出来的，判据是 insert_htmlbox 返回值的第二个元素
#      scale >= 1.0。只看第一个（剩余高度）会漏掉静默缩小：实测 200 段一次性塞进
#      一页返回 (0.0, 0.1591) —— 字确实都在，只是缩到 1.7pt，看上去是一页空白。
#      实测代价：单独 import pymupdf 0.064 秒 / 常驻 45MB（不是 pymupdf4llm 的
#      1.03 秒，那个只在解析上传的 PDF 时才付）；一次装箱探测 17.15 毫秒；
#      300 块 → 16 页 / 44 次探测 / 0.58 秒。收尾必须 tobytes(garbage=4,
#      deflate=True)：同一份 6 页文档实测裸 tobytes() 是 18,502,649 字节，
#      加了这两个参数是 27,206 字节（680 倍），因为 insert_htmlbox 每页都嵌一份
#      CJK 字体而裸 tobytes() 把每一份都留下，单独调 subset_fonts() 收敛不了。
#   3. 两条 CSS 是承重的，动之前先读 app/export.py 里的实测记录：
#      *{overflow-wrap:break-word} —— MuPDF 既不在 <pre> 里折行、也不断开散文中
#        断不了的长词，那一行于是横向溢出，insert_htmlbox 把整页缩小来补偿。
#        实测一条 300 字符的代码行让 scale 掉到 0.2873，加上它回到 1.0000。
#        word-break:break-all、overflow-wrap:anywhere 和旧别名 word-wrap:break-word
#        三种拼法在 MuPDF 的 CSS 子集里全部无效，别顺手"整理"成它们。
#      table{width:100%} —— 少了它 MuPDF 按内容给表格定宽，一张 30 行的普通短表格
#        实测掉到 0.8634、37 行的掉到 0.6840；加上它都回到 1.0000。
#      残留限制：MuPDF 按列里最长的不可断词给列定宽，所以一个塞了 180 个连续
#      ASCII 字符的单元格会把整份文档钉在 0.9086，与行数无关（60 行 → 52 页，
#      其中 48 页 0.91、4 页 0.51）。仍然可读，只是没有铺满页宽。
#   4. 图片永远不会被导出。renderMarkdown 没有图片分支，![alt](src) 只渲染成
#      一个字的 "!" 加一个链接，msg.images 里的 base64 从来不进 markdown 输出。
#      链接则两侧都保留：PDF 与 DOCX 都是真超链接，不是只剩样式化的文字。
#      （PDF 里的链接注释要 tobytes() 之后重开文档才看得见，在活动页上调
#      get_links() 返回空列表 —— 别据此以为链接丢了。）
# 导出用浅色配色（白底黑字、代码块 #f6f7f9），与屏幕上的深色主题不同：文件是
# 拿去别处看、打印、进 Word 的。最危险的一个值是 style.css 里 .md pre 的深色底
# #10131a，在白纸上会印成一整块实心黑，两份导出 CSS 里都必须换成 #f6f7f9。
# ⚠️ 系统提示词里新加的那句「用户想要文件时，直接输出完整的 Markdown 正文，并
# 提示他点导出」对保存过提示词的用户不生效 —— 见下面的优先级：
# settings_override.json 与本文件里的 SYSTEM_PROMPT 都会盖掉默认值。
# 导出按钮本身照常可用，少的只是模型主动提一句。导出面板检测到生效的提示词里
# 没有这句话时会给出提示，但不会去改你亲手编辑过的覆盖文件。

# ---- runtime/settings_override.json（无需配置，这里只说明它是什么）----
# 网页左下角「设置」面板保存的改动写在这个文件里，优先级高于本文件：
#   settings_override.json  >  .env  >  app/config.py 里的默认值
# 它只能包含上面提到的那 8 项（SYSTEM_PROMPT、TEMPERATURE、TOP_P、MAX_TOKENS、
# MAX_TOOL_ROUNDS、THINKING_MAX_TOKENS、SEARCH_PROVIDER、SEARCH_MAX_RESULTS）；
# 其余键即使在文件里出现也会被忽略，不会生效。
# 面板里的「恢复 .env 默认值」就是删掉这个文件，手动删除效果相同。
# 通过面板保存是立即生效的；直接手改这个文件则要重启应用才会读到。
# 手改出错（JSON 语法坏了、数值越界）时应用会忽略整个文件并照常启动，不会起不来。
